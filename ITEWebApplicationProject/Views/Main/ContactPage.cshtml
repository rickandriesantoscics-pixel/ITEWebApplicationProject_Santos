@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewBag.Title = "Contact";
}

<div class="card">
    <div class="card-content">
        <span class="card-title">Contact Us</span>
        <p class="grey-text text-darken-1">
            Have a question or feedback? Reach the ThreadLine team through any of the following.
        </p>

        <div class="row mt-6">

            <div class="col s12 m6">
                <p class="text-xl font-semibold text-slate-800">Customer Support</p>
                <p class="grey-text text-darken-1">ThreadLine Clothing Store</p>
            </div>

            <div class="col s12 m6">
                <p><i class="material-icons left">mail</i><strong>Email</strong><br />support@threadline.example</p>
            </div>

            <div class="col s12 m6">
                <p><i class="material-icons left">call</i><strong>Phone</strong><br />0917 000 0000</p>
            </div>

            <div class="col s12 m6">
                <p><i class="material-icons left">location_on</i><strong>Address</strong><br />123 Fashion Street, Manila, Philippines</p>
            </div>

            <div class="col s12 m6">
                <p><i class="material-icons left">schedule</i><strong>Store Hours</strong><br />Monday &ndash; Saturday, 9:00 AM &ndash; 8:00 PM</p>
            </div>

            <div class="col s12 m6">
                <p><i class="material-icons left">share</i><strong>Social Media</strong><br />Facebook: &#64;ThreadLinePH<br />Instagram: &#64;threadline.ph</p>
            </div>

        </div>
    </div>
</div>
