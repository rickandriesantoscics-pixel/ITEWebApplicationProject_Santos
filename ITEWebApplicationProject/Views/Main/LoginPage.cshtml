@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<h2>Login</h2>
<form ng-submit="processLogin()">
    <div>
        <label>Username:</label>
        <input type="text" ng-model="loginUsername" required />
    </div>
    <div>
        <label>Password:</label>
        <input type="password" ng-model="loginPassword" required />
    </div>

    <!-- Redirect handled in AngularJS -->
    <button ng-click="loginFunc()">Login</button>
    <button ng-click="clearLogin()">Clear</button>
</form>

<p>Don't have an account? <a href="">Register here</a>.</p>