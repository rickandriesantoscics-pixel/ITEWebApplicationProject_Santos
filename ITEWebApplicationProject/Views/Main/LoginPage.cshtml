@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewBag.Title = "Login";
}
  
<div class="max-w-md mx-auto">
    <div class="card">
        <div class="card-content">
            <span class="card-title">ThreadLine Login</span>
            <p class="grey-text text-darken-1">Sign in to manage customer records.</p>

            <form ng-submit="$event.preventDefault()">

                <div class="input-field">
                    <input id="login_username" type="text" ng-model="loginUsername" required />
                    <label for="login_username">Username</label>
                </div>

                <div class="input-field">
                    <input id="login_password" type="password" ng-model="loginPassword" required />
                    <label for="login_password">Password</label>
                </div>

                <div class="row">
                    <div class="col s12 m6">
                        <button class="btn waves-effect btn-store w-full" type="button" ng-click="loginFunc()">Login</button>
                    </div>
                    <div class="col s12 m6">
                        <button class="btn waves-effect btn-store-outline w-full" type="button" ng-click="clearLoginFunc()">Clear</button>
                    </div>
                </div>

            </form>

            <p class="center-align mt-4">
                Don't have an account?
                <a class="cursor-pointer font-semibold" ng-click="redirectFunc('/Main/RegistrationPage')">Register here</a>
            </p>
        </div>
    </div>
</div>
