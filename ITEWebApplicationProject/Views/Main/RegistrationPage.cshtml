@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewBag.Title = "Customer Registration";
}

<div class="card">
    <div class="card-content">
        <span class="card-title">{{ editingIndex == -1 ? 'Register a Customer' : 'Editing a Customer' }}</span>
        <p class="grey-text text-darken-1">
            {{ editingIndex == -1 ? 'Fill in the customer details below, then click Register Customer.' : 'Update the details below, then click Update Customer.' }}
        </p>
        <p class="grey-text text-darken-1 text-sm mt-1">
            Fields marked with <span class="req">*</span> are required.
        </p>

        <form ng-submit="$event.preventDefault()">

            <div class="row">
                <div class="input-field col s12">
                    <input id="username" type="text" ng-model="username" required maxlength="20" />
                    <label for="username">Username <span class="req">*</span></label>
                    <span class="helper-text">Maximum 20 characters. Must be unique.</span>
                </div>
            </div>

            <div class="row">
                <div class="input-field col s12 m6">
                    <input id="first_name" type="text" ng-model="firstName" required maxlength="50" />
                    <label for="first_name">First Name <span class="req">*</span></label>
                    <span class="helper-text">Maximum 50 characters.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="middle_name" type="text" ng-model="middleName" maxlength="50" />
                    <label for="middle_name">Middle Name <span class="grey-text">(optional)</span></label>
                    <span class="helper-text">Optional. Maximum 50 characters.</span>
                </div>
            </div>

            <div class="row">
                <div class="input-field col s12 m6">
                    <input id="last_name" type="text" ng-model="lastName" required maxlength="50" />
                    <label for="last_name">Last Name <span class="req">*</span></label>
                    <span class="helper-text">Maximum 50 characters.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="suffix" type="text" ng-model="suffix" maxlength="10" />
                    <label for="suffix">Suffix <span class="grey-text">(optional)</span></label>
                    <span class="helper-text">Optional (Jr., III, ...). Maximum 10 characters.</span>
                </div>
            </div>

            <div class="row">
                <div class="input-field col s12 m6">
                    <input id="email" type="email" ng-model="email" required maxlength="254" />
                    <label for="email">Email Address <span class="req">*</span></label>
                    <span class="helper-text">Valid email address. Must be unique.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="contact_number" type="tel" ng-model="contactNumber" required maxlength="11"/>
                    <label for="contact_number">Contact Number <span class="req">*</span></label>
                    <span class="helper-text">Must start with 09 and be exactly 11 digits.</span>
                </div>
            </div>

            <div class="row">
                <div class="input-field col s12 m6">
                    <input id="password" type="password" ng-model="password" required maxlength="64" />
                    <label for="password">Password <span class="req">*</span></label>
                    <span class="helper-text">At least 8 characters with uppercase, lowercase, number, and special character.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="confirm_password" type="password" ng-model="confirmPassword" required maxlength="64" />
                    <label for="confirm_password">Confirm Password <span class="req">*</span></label>
                    <span class="helper-text">Must match the password.</span>
                </div>
            </div>

            <div class="row">
                <div class="col s12 m6">
                    <label for="gender" class="block text-sm font-medium text-slate-700 mb-1 mt-3">Gender <span class="req">*</span></label>
                    <select id="gender" class="browser-default" ng-model="gender">
                        <option value="" disabled selected>Select gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Prefer not to say">Prefer not to say</option>
                    </select>
                    <span class="helper-text">Select one.</span>
                </div>
                <div class="input-field col s12 m6">
                    <input id="birthday" type="date" ng-model="birthday" ng-model-options="{ allowInvalid: true }" max="{{today}}" required />
                    <label for="birthday" class="active">Birthday <span class="req">*</span></label>
                    <span class="helper-text">Cannot be a future date.</span>
                </div>
            </div>

            <div class="row">
                <div class="input-field col s12">
                    <input id="address" type="text" ng-model="address" required maxlength="254" />
                    <label for="address">Address <span class="req">*</span></label>
                    <span class="helper-text">Maximum 254 characters.</span>
                </div>
            </div>

            <div class="row">
                <div class="col s12 m4">
                    <button class="btn waves-effect btn-store w-full" type="button" ng-click="registrationFunc()">Register Customer</button>
                </div>
                <div class="col s12 m4">
                    <button class="btn waves-effect btn-store-accent w-full" type="button" ng-click="updateFunc(editingIndex)">Update Customer</button>
                </div>
                <div class="col s12 m4">
                    <button class="btn waves-effect btn-store-outline w-full" type="button" ng-click="clearRegistrationFunc()">Clear Form</button>
                </div>
            </div>

        </form>
    </div>
</div>

<!-- Records table -->
<div class="card">
    <div class="card-content">
        <span class="card-title">Registered Customers</span>
        <p class="grey-text text-darken-1">All customer records currently stored in the system.</p>

        <table class="striped responsive-table">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Middle Name</th>
                    <th>Last Name</th>
                    <th>Suffix</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Contact Number</th>
                    <th>Gender</th>
                    <th>Birthday</th>
                    <th>Address</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="customer in customerArray">
                    <td>{{customer.FName}}</td>
                    <td>{{customer.MName}}</td>
                    <td>{{customer.LName}}</td>
                    <td>{{customer.Suffix}}</td>
                    <td>{{customer.Username}}</td>
                    <td>{{customer.Email}}</td>
                    <td>{{customer.ContactNumber}}</td>
                    <td>{{customer.Gender}}</td>
                    <td>{{customer.Birthday | date:'yyyy-MM-dd'}}</td>
                    <td>{{customer.Address}}</td>
                    <td>
                        <button class="btn-small waves-effect btn-store" ng-click="editFunc($index)">Edit</button>
                        <button class="btn-small waves-effect btn-store-accent" ng-click="updateFunc($index)">Update</button>
                        <button class="btn-small waves-effect btn-store-outline" ng-click="deleteFunc($index)">Delete</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
