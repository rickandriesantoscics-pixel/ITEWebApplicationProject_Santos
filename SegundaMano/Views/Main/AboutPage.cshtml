@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Top Banner -->
    <div class="bg-[#541220] text-white p-6 sm:p-10 rounded-lg shadow-md border-b-2 border-[#380c16]">
        <h1 class="card-title font-serif text-3xl sm:text-4xl font-bold tracking-tight text-white m-0">
            About ThreadLine
        </h1>
        <p class="grey-text text-darken-1 text-stone-200 text-base sm:text-lg leading-relaxed mt-3 mb-0 max-w-3xl">
            ThreadLine is a Customer Management System for a clothing store, built with ASP.NET MVC and AngularJS.
            It lets the store register customers, view every record in a live table, update customer details,
            and remove records that are no longer needed.
        </p>
    </div>

    <!-- Content Card -->
    <div class="card border border-[#ded8cd] shadow-sm rounded-lg bg-white overflow-hidden m-0">
        <div class="card-content p-6 sm:p-10 space-y-8">
            
            <!-- Purpose -->
            <div>
                <h2 class="text-xl font-bold text-stone-900 font-serif border-b-2 border-stone-200 pb-2 mb-3">
                    Purpose
                </h2>
                <p class="grey-text text-darken-1 text-stone-700 text-base leading-relaxed m-0">
                    To provide a simple, connected system for keeping clothing-store customer records accurate and organised,
                    with client-side validation so incomplete or invalid data never enters the list.
                </p>
            </div>

            <!-- Features -->
            <div>
                <h2 class="text-xl font-bold text-stone-900 font-serif border-b-2 border-stone-200 pb-2 mb-3">
                    Features
                </h2>
                <ul class="collection border-0 m-0 p-0 space-y-2">
                    <li class="collection-item border border-[#ded8cd] rounded p-3.5 flex items-center gap-3 bg-[#faf8f4] text-stone-800 font-medium">
                        <i class="material-icons text-[#6b1d2f]">person_add</i>
                        <span>Register new customers with complete details</span>
                    </li>
                    <li class="collection-item border border-[#ded8cd] rounded p-3.5 flex items-center gap-3 bg-[#faf8f4] text-stone-800 font-medium">
                        <i class="material-icons text-[#6b1d2f]">table_view</i>
                        <span>View all customers in a live, dynamically bound table</span>
                    </li>
                    <li class="collection-item border border-[#ded8cd] rounded p-3.5 flex items-center gap-3 bg-[#faf8f4] text-stone-800 font-medium">
                        <i class="material-icons text-[#6b1d2f]">edit_note</i>
                        <span>Edit and update existing customer records</span>
                    </li>
                    <li class="collection-item border border-[#ded8cd] rounded p-3.5 flex items-center gap-3 bg-[#faf8f4] text-stone-800 font-medium">
                        <i class="material-icons text-[#6b1d2f]">delete</i>
                        <span>Delete records with a confirmation prompt</span>
                    </li>
                    <li class="collection-item border border-[#ded8cd] rounded p-3.5 flex items-center gap-3 bg-[#faf8f4] text-stone-800 font-medium">
                        <i class="material-icons text-[#6b1d2f]">check_circle</i>
                        <span>Client-side validation with SweetAlert2 feedback</span>
                    </li>
                </ul>
            </div>

            <!-- Technologies Used -->
            <div>
                <h2 class="text-xl font-bold text-stone-900 font-serif border-b-2 border-stone-200 pb-2 mb-3">
                    Technologies Used
                </h2>
                <div class="row m-0 -mx-2">
                    <div class="col s12 m6 px-2 mb-3">
                        <ul class="collection border-0 m-0 p-0 space-y-2">
                            <li class="collection-item border border-[#ded8cd] rounded p-3 bg-stone-50 text-sm font-semibold text-stone-900">
                                ASP.NET MVC 5 (C#)
                            </li>
                            <li class="collection-item border border-[#ded8cd] rounded p-3 bg-stone-50 text-sm font-semibold text-stone-900">
                                AngularJS 1.x
                            </li>
                            <li class="collection-item border border-[#ded8cd] rounded p-3 bg-stone-50 text-sm font-semibold text-stone-900">
                                HTML5, CSS, JavaScript
                            </li>
                        </ul>
                    </div>
                    <div class="col s12 m6 px-2 mb-3">
                        <ul class="collection border-0 m-0 p-0 space-y-2">
                            <li class="collection-item border border-[#ded8cd] rounded p-3 bg-stone-50 text-sm font-semibold text-stone-900">
                                Materialize CSS
                            </li>
                            <li class="collection-item border border-[#ded8cd] rounded p-3 bg-stone-50 text-sm font-semibold text-stone-900">
                                Tailwind CSS
                            </li>
                            <li class="collection-item border border-[#ded8cd] rounded p-3 bg-stone-50 text-sm font-semibold text-stone-900">
                                SweetAlert2
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Project Information -->
            <div>
                <h2 class="text-xl font-bold text-stone-900 font-serif border-b-2 border-stone-200 pb-2 mb-3">
                    Project Information
                </h2>
                <p class="grey-text text-darken-1 text-stone-700 text-base leading-relaxed m-0">
                    ITE Electronic Machine Problem 1-1 &mdash; an ASP.NET MVC + AngularJS activity.
                    The application stores all records in an AngularJS array on the client; no database is used.
                </p>
            </div>

            <!-- Team -->
            <div class="pt-2">
                <h2 class="text-xl font-bold text-stone-900 font-serif border-b-2 border-stone-200 pb-2 mb-3">
                    Team
                </h2>
                <p class="grey-text text-darken-1 text-stone-800 text-base m-0">
                    Developed by <strong class="text-[#6b1d2f]">Rick Andrie R. Rocio</strong>.
                </p>
            </div>

        </div>
    </div>

</div>
