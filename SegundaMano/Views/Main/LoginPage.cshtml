@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
  
<div class="max-w-md mx-auto py-10 px-4">
    <div class="card border border-[#ded8cd] shadow-lg rounded-lg overflow-hidden bg-white">
        
        <!-- Top Banner -->
        <div class="bg-[#541220] p-6 text-white text-center border-b-2 border-[#380c16]">
            <div class="w-12 h-12 rounded bg-[#380c16] text-white mx-auto flex items-center justify-center mb-2 shadow-inner">
                <i class="material-icons text-2xl">checkroom</i>
            </div>
            <h1 class="card-title font-serif text-2xl font-bold text-white tracking-wide m-0">
                ThreadLine Login
            </h1>
            <p class="grey-text text-darken-1 text-stone-200 text-sm mt-1 mb-0">
                Sign in to manage customer records.
            </p>
        </div>

        <div class="card-content p-6 sm:p-8">
            <form ng-submit="$event.preventDefault()" class="space-y-4">

                <div class="input-field">
                    <input id="login_username" type="text" ng-model="loginUsername" required placeholder=" " autocomplete="username" />
                    <label for="login_username">Username</label>
                </div>

                <div class="input-field">
                    <input id="login_password" type="password" ng-model="loginPassword" required placeholder=" " autocomplete="current-password" />
                    <label for="login_password">Password</label>
                </div>

                <div class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <button class="btn waves-effect btn-store w-full cursor-pointer shadow-sm"
                            type="button"
                            ng-click="loginFunc()">
                        <i class="material-icons text-base">login</i>
                        <span>Login</span>
                    </button>
                    
                    <button class="btn waves-effect btn-store-outline w-full cursor-pointer shadow-sm"
                            type="button"
                            ng-click="clearLoginFunc()">
                        <i class="material-icons text-base">clear</i>
                        <span>Clear</span>
                    </button>
                </div>

            </form>

            <div class="mt-6 pt-6 border-t border-stone-200 text-center">
                <p class="text-sm text-stone-700 m-0">
                    Don't have an account?
                    <a class="cursor-pointer font-bold text-[#6b1d2f] hover:underline ml-1"
                       ng-click="redirectFunc('/Main/RegistrationPage')">
                        Register here
                    </a>
                </p>
            </div>
        </div>

    </div>
</div>
