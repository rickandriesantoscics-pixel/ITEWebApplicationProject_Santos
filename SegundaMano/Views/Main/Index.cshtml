@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div ng-init="GetWelcomeMessage()" class="space-y-12">

    <!-- Full-Width Hero Section: Covers the Whole Width of the Page -->
    <section class="w-full bg-gradient-to-r from-[#430d19] via-[#581423] to-[#6b1d2f] text-white py-14 sm:py-20 border-b-4 border-[#330812]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                
                <!-- Left Narrative & Buttons -->
                <div class="lg:col-span-7 space-y-6">
                    
                    <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight m-0">
                        {{ welcomeMessage }}
                    </h1>

                    <p class="text-stone-200 text-base sm:text-lg leading-relaxed max-w-2xl font-normal">
                        ThreadLine is a simple customer management system for a clothing store. Register customers,
                        keep their details organised, and manage every record in one connected system.
                    </p>

                    <!-- Action Buttons: Solid, Crisp, and Perfectly Sized -->
                    <div class="pt-2 flex flex-wrap items-center gap-4">
                        <a class="btn-large waves-effect btn-vintage-primary bg-[#801f34] hover:bg-[#6b1d2f] text-white font-bold px-7 rounded shadow cursor-pointer border border-[#9b2a41]"
                           ng-click="redirectFunc('/Main/RegistrationPage')">
                            <i class="material-icons text-xl">person_add</i>
                            <span>Register a Customer</span>
                        </a>

                        <!-- Solid About button: Solid White background with dark red border & text; fills with dark red on hover -->
                        <a class="btn-large waves-effect bg-white hover:bg-[#430d19] text-[#581423] hover:text-white font-bold px-7 rounded shadow cursor-pointer border-2 border-[#801f34] transition-all"
                           ng-click="redirectFunc('/Main/AboutPage')">
                            <i class="material-icons text-xl">info</i>
                            <span>About</span>
                        </a>
                    </div>

                </div>

                <!-- Right Visual: Clean Vintage Clothing Lookbook Showcase -->
                <div class="lg:col-span-5">
                    <div class="rounded-lg overflow-hidden shadow-2xl border-4 border-[#330812] bg-[#22070c]">
                        <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=1000&auto=format&fit=crop"
                             alt="ThreadLine Clothing Apparel"
                             class="w-full h-80 sm:h-96 object-cover object-center" />
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Main Content Container for Lower Sections -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 pb-6">

        <!-- 3 Feature Cards (Preserving all original titles, descriptions, and functional links) -->
        <div class="space-y-4">
            <div class="border-b-2 border-stone-300 pb-2">
                <h2 class="font-serif text-2xl font-bold text-stone-900 m-0">Store System Features</h2>
            </div>

            <div class="row m-0 -mx-3">
                
                <!-- Feature 1: Register Customers -->
                <div class="col s12 m4 px-3 mb-4">
                    <div class="card h-full border border-[#ded8cd] hover:border-[#6b1d2f] shadow-sm hover:shadow-md transition-all bg-white cursor-pointer group"
                         ng-click="redirectFunc('/Main/RegistrationPage')">
                        <div class="card-content flex flex-col justify-between h-full p-6">
                            <div>
                                <div class="w-12 h-12 rounded bg-[#faf8f4] border border-[#ded8cd] text-[#6b1d2f] flex items-center justify-center mb-4 group-hover:bg-[#6b1d2f] group-hover:text-white transition-colors">
                                    <i class="material-icons text-2xl">person_add</i>
                                </div>
                                <h3 class="card-title font-serif text-xl font-bold text-stone-900 mb-2">
                                    Register Customers
                                </h3>
                                <p class="grey-text text-darken-1 text-stone-700 text-sm leading-relaxed m-0">
                                    Add new customer records with complete, validated details.
                                </p>
                            </div>
                            <div class="pt-4 flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#6b1d2f]">
                                <span>Go to form</span>
                                <i class="material-icons text-sm">arrow_forward</i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Feature 2: View Records -->
                <div class="col s12 m4 px-3 mb-4">
                    <div class="card h-full border border-[#ded8cd] hover:border-[#6b1d2f] shadow-sm hover:shadow-md transition-all bg-white cursor-pointer group"
                         ng-click="redirectFunc('/Main/RegistrationPage')">
                        <div class="card-content flex flex-col justify-between h-full p-6">
                            <div>
                                <div class="w-12 h-12 rounded bg-[#faf8f4] border border-[#ded8cd] text-[#6b1d2f] flex items-center justify-center mb-4 group-hover:bg-[#6b1d2f] group-hover:text-white transition-colors">
                                    <i class="material-icons text-2xl">table_view</i>
                                </div>
                                <h3 class="card-title font-serif text-xl font-bold text-stone-900 mb-2">
                                    View Records
                                </h3>
                                <p class="grey-text text-darken-1 text-stone-700 text-sm leading-relaxed m-0">
                                    See every customer in a live table that updates instantly.
                                </p>
                            </div>
                            <div class="pt-4 flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#6b1d2f]">
                                <span>View records</span>
                                <i class="material-icons text-sm">arrow_forward</i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Feature 3: Edit or Delete -->
                <div class="col s12 m4 px-3 mb-4">
                    <div class="card h-full border border-[#ded8cd] hover:border-[#6b1d2f] shadow-sm hover:shadow-md transition-all bg-white cursor-pointer group"
                         ng-click="redirectFunc('/Main/RegistrationPage')">
                        <div class="card-content flex flex-col justify-between h-full p-6">
                            <div>
                                <div class="w-12 h-12 rounded bg-[#faf8f4] border border-[#ded8cd] text-[#6b1d2f] flex items-center justify-center mb-4 group-hover:bg-[#6b1d2f] group-hover:text-white transition-colors">
                                    <i class="material-icons text-2xl">edit_note</i>
                                </div>
                                <h3 class="card-title font-serif text-xl font-bold text-stone-900 mb-2">
                                    Edit or Delete
                                </h3>
                                <p class="grey-text text-darken-1 text-stone-700 text-sm leading-relaxed m-0">
                                    Update existing records or remove them with a confirmation.
                                </p>
                            </div>
                            <div class="pt-4 flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#6b1d2f]">
                                <span>Manage records</span>
                                <i class="material-icons text-sm">arrow_forward</i>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Classic Vintage Clothing Collections Showcase -->
        <div class="space-y-4">
            <div class="border-b-2 border-stone-300 pb-2">
                <h2 class="font-serif text-2xl font-bold text-stone-900 m-0">Featured Vintage Apparel</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white border border-[#ded8cd] rounded-lg overflow-hidden shadow-sm">
                    <div class="h-44 overflow-hidden bg-stone-100">
                        <img src="https://images.unsplash.com/photo-1594938298603-c8148c4dae35?q=80&w=800&auto=format&fit=crop"
                             alt="Classic Tailored Suiting"
                             class="w-full h-full object-cover" />
                    </div>
                    <div class="p-5">
                        <h3 class="font-serif text-lg font-bold text-stone-900 m-0">Classic Tailoring &amp; Suiting</h3>
                        <p class="text-xs text-stone-600 mt-1 mb-0">Fine wool blazers, vests, and bespoke shirts tailored for enduring elegance.</p>
                    </div>
                </div>

                <div class="bg-white border border-[#ded8cd] rounded-lg overflow-hidden shadow-sm">
                    <div class="h-44 overflow-hidden bg-stone-100">
                        <img src="https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?q=80&w=800&auto=format&fit=crop"
                             alt="Heritage Cotton & Linens"
                             class="w-full h-full object-cover" />
                    </div>
                    <div class="p-5">
                        <h3 class="font-serif text-lg font-bold text-stone-900 m-0">Heritage Cottons &amp; Linens</h3>
                        <p class="text-xs text-stone-600 mt-1 mb-0">Breathable vintage shirts, blouses, and trousers woven with natural fibers.</p>
                    </div>
                </div>

                <div class="bg-white border border-[#ded8cd] rounded-lg overflow-hidden shadow-sm">
                    <div class="h-44 overflow-hidden bg-stone-100">
                        <img src="https://images.unsplash.com/photo-1445205170230-053b83016050?q=80&w=800&auto=format&fit=crop"
                             alt="Vintage Outerwear"
                             class="w-full h-full object-cover" />
                    </div>
                    <div class="p-5">
                        <h3 class="font-serif text-lg font-bold text-stone-900 m-0">Vintage Coats &amp; Knitwear</h3>
                        <p class="text-xs text-stone-600 mt-1 mb-0">Warm trench coats, tweed jackets, and wool knits inspired by classic design.</p>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
