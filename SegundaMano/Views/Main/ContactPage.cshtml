@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Top Banner -->
    <div class="bg-[#541220] text-white p-6 sm:p-10 rounded-lg shadow-md border-b-2 border-[#380c16]">
        <h1 class="card-title font-serif text-3xl sm:text-4xl font-bold tracking-tight text-white m-0">
            Contact Us
        </h1>
        <p class="grey-text text-darken-1 text-stone-200 text-base sm:text-lg leading-relaxed mt-3 mb-0 max-w-3xl">
            Have a question or feedback? Reach the ThreadLine team through any of the following.
        </p>
    </div>

    <!-- Contact Information Grid Card -->
    <div class="card border border-[#ded8cd] shadow-sm rounded-lg bg-white overflow-hidden m-0">
        <div class="card-content p-6 sm:p-10">
            
            <div class="row m-0 -mx-3">

                <!-- Customer Support -->
                <div class="col s12 m6 px-3 mb-6">
                    <div class="p-5 rounded border-2 border-[#6b1d2f] bg-[#faf8f4] h-full flex flex-col justify-center">
                        <p class="text-xl font-bold text-stone-900 font-serif m-0">Customer Support</p>
                        <p class="grey-text text-darken-1 text-stone-700 text-sm mt-1 mb-0">ThreadLine Clothing Store</p>
                    </div>
                </div>

                <!-- Email -->
                <div class="col s12 m6 px-3 mb-6">
                    <div class="p-5 rounded border border-[#ded8cd] bg-white h-full flex items-start gap-4">
                        <div class="w-10 h-10 rounded bg-[#6b1d2f] text-white flex items-center justify-center shrink-0">
                            <i class="material-icons text-xl">mail</i>
                        </div>
                        <div>
                            <p class="text-base text-stone-900 font-bold m-0">Email</p>
                            <p class="text-stone-700 text-sm mt-0.5 mb-0 font-medium">support@threadline.example</p>
                        </div>
                    </div>
                </div>

                <!-- Phone -->
                <div class="col s12 m6 px-3 mb-6">
                    <div class="p-5 rounded border border-[#ded8cd] bg-white h-full flex items-start gap-4">
                        <div class="w-10 h-10 rounded bg-[#6b1d2f] text-white flex items-center justify-center shrink-0">
                            <i class="material-icons text-xl">call</i>
                        </div>
                        <div>
                            <p class="text-base text-stone-900 font-bold m-0">Phone</p>
                            <p class="text-stone-700 text-sm mt-0.5 mb-0 font-medium">0917 000 0000</p>
                        </div>
                    </div>
                </div>

                <!-- Address -->
                <div class="col s12 m6 px-3 mb-6">
                    <div class="p-5 rounded border border-[#ded8cd] bg-white h-full flex items-start gap-4">
                        <div class="w-10 h-10 rounded bg-[#6b1d2f] text-white flex items-center justify-center shrink-0">
                            <i class="material-icons text-xl">location_on</i>
                        </div>
                        <div>
                            <p class="text-base text-stone-900 font-bold m-0">Address</p>
                            <p class="text-stone-700 text-sm mt-0.5 mb-0 font-medium">123 Fashion Street, Manila, Philippines</p>
                        </div>
                    </div>
                </div>

                <!-- Store Hours -->
                <div class="col s12 m6 px-3 mb-6">
                    <div class="p-5 rounded border border-[#ded8cd] bg-white h-full flex items-start gap-4">
                        <div class="w-10 h-10 rounded bg-[#6b1d2f] text-white flex items-center justify-center shrink-0">
                            <i class="material-icons text-xl">schedule</i>
                        </div>
                        <div>
                            <p class="text-base text-stone-900 font-bold m-0">Store Hours</p>
                            <p class="text-stone-700 text-sm mt-0.5 mb-0 font-medium">Monday &ndash; Saturday, 9:00 AM &ndash; 8:00 PM</p>
                        </div>
                    </div>
                </div>

                <!-- Social Media -->
                <div class="col s12 m6 px-3 mb-6">
                    <div class="p-5 rounded border border-[#ded8cd] bg-white h-full flex items-start gap-4">
                        <div class="w-10 h-10 rounded bg-[#6b1d2f] text-white flex items-center justify-center shrink-0">
                            <i class="material-icons text-xl">share</i>
                        </div>
                        <div>
                            <p class="text-base text-stone-900 font-bold m-0">Social Media</p>
                            <div class="text-stone-700 text-sm mt-0.5 mb-0 font-medium space-y-0.5">
                                <div>Facebook: &#64;ThreadLinePH</div>
                                <div>Instagram: &#64;threadline.ph</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>

</div>
